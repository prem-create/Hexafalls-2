# ============================================================
# Walking Eye - AI Perception Engine
# Environment Configuration Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control.
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Comma-separated list of allowed CORS origins.
# Use * for development. Lock this down in production.
# Example: ALLOWED_ORIGINS=["https://myapp.com","https://api.myapp.com"]
ALLOWED_ORIGINS=["*"]

# --- Model ---
# Path to the YOLO weights file.
# If the file doesn't exist, Ultralytics will auto-download it.
# Options: yolov8n.pt | yolov8s.pt | yolov8m.pt | yolov8l.pt | yolov8x.pt
# n = nano (fastest), x = extra-large (most accurate)
MODEL_PATH=models/yolov8n.pt

# Minimum confidence score to include a detection (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.45

# --- Image Processing ---
# Maximum file size in megabytes
MAX_IMAGE_SIZE_MB=10.0

# Longest image edge will be resized to this if exceeded (preserves aspect ratio)
MAX_IMAGE_DIMENSION=1280

# --- Logging ---
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Uploads ---
UPLOAD_DIR=uploads

# ============================================================
# Future Feature Flags (set to true to enable when ready)
# ============================================================

ENABLE_OCR=false
# Set to true to enable MiDaS DPT_Hybrid depth estimation (GPU recommended)
ENABLE_DEPTH=true
# Set to true to enable temporal object tracking and motion analysis (recommended)
ENABLE_TRACKING=true

# ============================================================
# Depth Estimation Settings (MiDaS DPT_Hybrid)
# ============================================================

# Model type: DPT_Hybrid (recommended) | DPT_Large | MiDaS_small
DEPTH_MODEL_TYPE=DPT_Hybrid

# Fixed scale: depth_metres = DEPTH_SCALE_FACTOR / midas_inverse_depth
# 7.5 works well for typical walking scenes (1–10 m range). Tune if needed.
DEPTH_SCALE_FACTOR=7.5

# Auto-calibrate scale using detected person bbox height (recommended: true)
DEPTH_PERSON_ANCHOR=true

# Assumed average standing person height in metres
PERSON_HEIGHT_M=1.70

# Patch size (pixels) for depth sampling around each detection centre
DEPTH_PATCH_SIZE=11

# ============================================================
# Temporal Motion Analysis Settings
# ============================================================

# Number of past observations kept per tracked object (3–10 recommended)
HISTORY_SIZE=5

# Minimum observations before issuing a motion classification
MIN_TRACK_HISTORY=2

# Depth-based thresholds (metres) — change smaller than this = STATIONARY
STATIONARY_DEPTH_THRESHOLD=0.08
APPROACHING_DEPTH_THRESHOLD=0.08

# BBox-scale thresholds (fractional area change, 0–1) — used when depth unavailable
STATIONARY_SCALE_THRESHOLD=0.05
APPROACHING_SCALE_THRESHOLD=0.05

# Pixel threshold below which centre-point movement is treated as noise
DIRECTION_NOISE_THRESHOLD_PX=5

# Minimum confidence to surface a motion classification
MOTION_CONFIDENCE_THRESHOLD=0.50

# IoU overlap required to associate a detection with an existing track (0–1)
TRACKER_IOU_THRESHOLD=0.30

# Frames a track may go unmatched before expiry
TRACKER_MAX_AGE=5

# Maximum concurrent tracking sessions held in memory
MAX_TRACKER_SESSIONS=50

# --- Future: External LLM Integration ---
# Used when replacing rule-based scene summaries with an LLM
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_ENDPOINT=
